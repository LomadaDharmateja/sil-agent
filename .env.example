# Copy to .env and adjust. .env is gitignored; this file is committed.

# Development database — used by the CLI.
DATABASE_URL=postgresql+psycopg://sil:sil@localhost:5432/sil_agent

# Test database — used by pytest. Must be a DIFFERENT database: the test
# fixtures truncate tables between tests.
TEST_DATABASE_URL=postgresql+psycopg://sil:sil@localhost:5432/sil_agent_test

# Run locking, from Phase 3.
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# LLM providers
#
# From Phase 3.5 the primary is a LOCAL model and no key is needed to run the
# agent. The hosted providers below are optional failover.
#
# NEVER put a real key in this file — it is committed, and the repository is
# public. Real keys go in .env, which is gitignored.
# ---------------------------------------------------------------------------

# --- Ollama, the primary. No key: the credential is a process on localhost. ---
#
#   winget install Ollama.Ollama
#   ollama pull qwen3:4b-q4_K_M
#   ollama ps          # confirm it is on the GPU, not silently on the CPU
#
# Why local is the default, and it is not only cost: a pinned local model reruns
# byte-identically in two years. No hosted API can promise that — providers move
# models under a stable alias without notice, and published numbers quietly stop
# reproducing. Phase 3 had to weaken Rule 1 for that reason; this restores it.
#
# The full tag INCLUDING the quantisation is deliberate. A bare `qwen3:4b` is
# repointed upstream, which would destroy the reproducibility just described.
# SIL_OLLAMA_MODEL=qwen3:4b-q4_K_M
# OLLAMA_HOST=http://localhost:11434

# Context window. Every token of this is VRAM, so it is a real trade-off.
# Measured on an RTX 3050 Ti (4 GB): 4096 -> 3.6 GB and a 2.2 s warm call;
# 8192 -> 4.3 GB and 2.8 s. The model does not fit entirely on a 4 GB card at
# any setting, so a partial CPU offload is expected — a *full* one is not, and
# `ollama ps` is how you tell them apart.
#
# Ollama truncates an over-long prompt SILENTLY rather than failing, which would
# produce a run that looks healthy and means nothing, so the adapter refuses
# instead. If you see that error, this is the knob.
# OLLAMA_NUM_CTX=4096

# Sampling seed. This is what makes a local run reproducible.
# OLLAMA_SEED=0

# Set to 1 to skip registering Ollama entirely (CI, or a machine without it).
# SIL_DISABLE_OLLAMA=

# Workhorse. ~1M tokens/day free. Get one at https://cloud.cerebras.ai
CEREBRAS_API_KEY=

# Fallback, and the more reliable of the two at structured output.
# https://aistudio.google.com
#
# IMPORTANT, and not what TECHNICAL_DESIGN §5 assumed: the free tier meters
# `GenerateRequestsPerDayPerProjectPerModel` at **20 requests per day, per
# model** — not 1,000. One 50-evaluation agent run needs 50 calls, so it does
# not fit on a single model. The quota is per model, so several models can be
# used in sequence, but a full ablation needs a paid tier or a provider with a
# genuinely generous free tier (Groq).
GEMINI_API_KEY=

# Which provider a run prefers. Falls back to the others on repeated failure.
# Defaults to `ollama`. Point it at a hosted provider only for a deliberate
# comparison — and note that at 20 requests/day the hosted tiers are not
# meaningful capacity, they keep the failover path exercised.
SIL_PRIMARY_PROVIDER=ollama

# Override the pacing between provider calls, in seconds. Defaults to the
# preferred provider's published rate limit (Gemini free tier is 15/min -> 4s).
# Deliberate spacing is faster than being rate limited into backoff.
# SIL_MIN_CALL_INTERVAL_S=4.0
